    "POST /v1/connect/connectors/{connector}/projects/{projectId}": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "upsertConnectorProjectConnection",
        "parameters": [
          {
            "description": "Stable connector ID or URL-encoded team-scoped UID. Examples: `scl_abc123` or `slack%2Fmy-bot`.",
            "in": "path",
            "name": "connector",
            "required": true,
            "schema": {
              "description": "Stable connector ID or URL-encoded team-scoped UID. Examples: `scl_abc123` or `slack%2Fmy-bot`.",
