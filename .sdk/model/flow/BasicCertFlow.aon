# BasicCertFlow

main: kit: flow: BasicCertFlow:
{
  entity: "cert",
  kind: "basic",
  name: "BasicCertFlow",
  step: [
    {
      input: {
        ref: "cert_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "cert_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "cert_ref01",
        srcdatavar: "cert_ref01_data",
        suffix: "_up0",
        textfield: "ca"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cert_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "cert_ref01",
        srcdatavar: "cert_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "cert01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cert_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "cert_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "cert01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "cert_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCertFlow"
}