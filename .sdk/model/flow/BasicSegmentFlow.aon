# BasicSegmentFlow

main: kit: flow: BasicSegmentFlow:
{
  entity: "segment",
  kind: "basic",
  name: "BasicSegmentFlow",
  step: [
    {
      input: {
        ref: "segment_ref01",
        srcdatavar: "segment_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "segment01",
        project_id: "project01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-segment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSegmentFlow"
}