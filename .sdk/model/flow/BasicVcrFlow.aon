# BasicVcrFlow

main: kit: flow: BasicVcrFlow:
{
  entity: "vcr",
  kind: "basic",
  name: "BasicVcrFlow",
  step: [
    {
      input: {
        ref: "vcr_ref01"
      }

      match: {
        id_or_name: "id_or_name01",
        project_slug: "project_slug01",
        repository_id: "repository01",
        repository_name: "repository_name01",
        team_slug: "team_slug01"
      }

      op: "create"
    }

    {
      match: {
        project_slug: "project_slug01",
        repository_name: "repository_name01",
        team_slug: "team_slug01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "vcr_ref01"
          }
        }
      ]
    }

    {
      data: {
        project_slug: "project_slug01",
        repository_name: "repository_name01",
        team_slug: "team_slug01"
      }

      input: {
        ref: "vcr_ref01",
        srcdatavar: "vcr_ref01_data",
        suffix: "_up0",
        textfield: "arch"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vcr_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "vcr_ref01",
        srcdatavar: "vcr_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-vcr_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "vcr_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "vcr01",
        project_slug: "project_slug01",
        repository_name: "repository_name01",
        team_slug: "team_slug01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        project_slug: "project_slug01",
        repository_name: "repository_name01",
        team_slug: "team_slug01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "vcr_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVcrFlow"
}