# BasicFeatureFlagFlow

main: kit: flow: BasicFeatureFlagFlow:
{
  entity: "feature_flag",
  kind: "basic",
  name: "BasicFeatureFlagFlow",
  step: [
    {
      match: {
        project_id: "project01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "feature_flag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "feature_flag_ref01",
        srcdatavar: "feature_flag_ref01_data",
        suffix: "_up0",
        textfield: "createdBy"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-feature_flag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "feature_flag_ref01",
        srcdatavar: "feature_flag_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "feature_flag01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-feature_flag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFeatureFlagFlow"
}