# BasicEnvFlow

main: kit: flow: BasicEnvFlow:
{
  entity: "env",
  kind: "basic",
  name: "BasicEnvFlow",
  step: [
    {
      input: {
        ref: "env_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "env_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "env_ref01",
        srcdatavar: "env_ref01_data",
        suffix: "_up0",
        textfield: "comment"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-env_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "env_ref01",
        srcdatavar: "env_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "env01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-env_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "env_ref01",
        suffix: "_rm0"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "env_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnvFlow"
}