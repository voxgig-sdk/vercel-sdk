# BasicDomainFlow

main: kit: flow: BasicDomainFlow:
{
  entity: "domain",
  kind: "basic",
  name: "BasicDomainFlow",
  step: [
    {
      input: {
        ref: "domain_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "domain_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "domain_ref01",
        srcdatavar: "domain_ref01_data",
        suffix: "_up0",
        textfield: "echMode"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "domain_ref01",
        srcdatavar: "domain_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "domain01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "domain_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "domain01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "domain_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDomainFlow"
}