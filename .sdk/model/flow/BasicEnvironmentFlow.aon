# BasicEnvironmentFlow

main: kit: flow: BasicEnvironmentFlow:
{
  entity: "environment",
  kind: "basic",
  name: "BasicEnvironmentFlow",
  step: [
    {
      input: {
        ref: "environment_ref01"
      }

      match: {
        env_id: "env01",
        id_or_name: "id_or_name01",
        project_id: "project01"
      }

      op: "create"
    }

    {
      match: {
        id_or_name: "id_or_name01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "environment_ref01"
          }
        }
      ]
    }

    {
      data: {
        project_id: "project01"
      }

      input: {
        ref: "environment_ref01",
        srcdatavar: "environment_ref01_data",
        suffix: "_up0",
        textfield: "copyEnvVarsFrom"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "environment_ref01",
        srcdatavar: "environment_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "environment01",
        project_id: "project01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-environment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "environment_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "environment01",
        project_id: "project01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        id_or_name: "id_or_name01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "environment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEnvironmentFlow"
}