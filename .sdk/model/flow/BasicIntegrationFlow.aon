# BasicIntegrationFlow

main: kit: flow: BasicIntegrationFlow:
{
  entity: "integration",
  kind: "basic",
  name: "BasicIntegrationFlow",
  step: [
    {
      input: {
        ref: "integration_ref01"
      }

      match: {
        configuration_id: "configuration01",
        integration_id: "integration01",
        product_id_or_slug: "product_or_slug01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "integration_ref01",
        srcdatavar: "integration_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "integration01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-integration_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "integration_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "integration01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "integration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIntegrationFlow"
}