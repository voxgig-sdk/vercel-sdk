    {
      input: {
        ref: "private_link_endpoint_ref01",
        srcdatavar: "private_link_endpoint_ref01_data",
        suffix: "_up0",
        textfield: "awsServiceName"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-private_link_endpoint_ref01"
          }
        }
