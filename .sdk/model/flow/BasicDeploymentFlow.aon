# BasicDeploymentFlow

main: kit: flow: BasicDeploymentFlow:
{
  entity: "deployment",
  kind: "basic",
  name: "BasicDeploymentFlow",
  step: [
    {
      input: {
        ref: "deployment_ref01"
      }

      match: {
        id_or_url: "id_or_url01",
        integration_id: "integration01",
        resource_id: "resource01"
      }

      op: "create"
    }

    {
      match: {
        id_or_url: "id_or_url01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "deployment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deployment_ref01",
        srcdatavar: "deployment_ref01_data",
        suffix: "_up0",
        textfield: "buildMachine"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deployment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deployment_ref01",
        srcdatavar: "deployment_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "deployment01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deployment_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deployment_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "deployment01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        id_or_url: "id_or_url01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "deployment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeploymentFlow"
}