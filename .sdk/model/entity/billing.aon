# Entity: billing

main: kit: entity: billing: {

  alias: field: {}

  name: "billing"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            query: [
              {
                example: "my-team-url-slug"
                kind: "query"
                name: "slug"
                orig: "slug"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "source"
                orig: "source"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                kind: "query"
                name: "team_id"
                orig: "team_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /v1/billing/buy"
            json: "{\"operationId\":\"buyCredits\",\"parameters\":[{\"description\":\"The source of the purchase request. Defaults to `api` if not specified.\",\"in\":\"query\",\"name\":\"source\",\"schema\":{\"description\":\"The source of the purchase request. Defaults to `api` if not specified.\",\"type\":\"string\"}},{\"description\":\"The Team identifier to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"teamId\",\"schema\":{\"example\":\"team_1a2b3c4d5e6f7g8h9i0j1k2l\",\"type\":\"string\"}},{\"description\":\"The Team slug to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"slug\",\"schema\":{\"example\":\"my-team-url-slug\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"item\":{\"properties\":{\"amount\":{\"description\":\"The amount of credits to purchase.\",\"minimum\":1,\"type\":\"integer\"},\"creditType\":{\"description\":\"The type of credits to purchase.\",\"enum\":[\"v0\",\"gateway\",\"agent\"],\"type\":\"string\"},\"type\":{\"description\":\"The type of item to purchase.\",\"enum\":[\"credits\"],\"type\":\"string\"}},\"required\":[\"type\",\"creditType\",\"amount\"],\"type\":\"object\"}},\"required\":[\"item\"],\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"properties\":{\"checkoutSessionId\":{\"type\":\"string\"},\"checkoutSessionUrl\":{\"type\":\"string\"}},\"required\":[\"checkoutSessionId\",\"checkoutSessionUrl\"],\"type\":\"object\"},{\"properties\":{\"purchaseIntent\":{\"description\":\"The created purchase intent\",\"properties\":{\"configuration\":{\"oneOf\":[{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"description\":\"Purchase configuration specific options\",\"properties\":{\"amount\":{\"description\":\"The amount of currency to buy\",\"type\":\"string\"},\"currency\":{\"description\":\"The currency being purchased\",\"enum\":[\"ai_credits\",\"ai_gateway_credits\",\"copper_test_units\",\"v0_user_credits\",\"vercel_agent_credits\"],\"type\":\"string\"},\"expirationDate\":{\"description\":\"The expiration date of the credits being purchased\",\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"output\":{\"nullable\":true},\"type\":{\"enum\":[\"credit_topup\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"properties\":{\"items\":{\"items\":{\"properties\":{\"name\":{\"type\":\"string\"},\"subtotal\":{\"description\":\"The subtotal of the domain name purchase\",\"type\":\"string\"},\"type\":{\"enum\":[\"purchase\",\"renewal\",\"transfer\"],\"type\":\"string\"},\"years\":{\"description\":\"The number of years to purchase\",\"type\":\"number\"}},\"required\":[\"name\",\"subtotal\",\"type\",\"years\"],\"type\":\"object\"},\"type\":\"array\"},\"orderId\":{\"description\":\"The order ID of the domain name purchase\",\"type\":\"string\"}},\"required\":[\"items\",\"orderId\"],\"type\":\"object\"},\"output\":{\"nullable\":true},\"type\":{\"enum\":[\"domain_name\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"properties\":{\"alignBillingWithPlanChangeDate\":{\"description\":\"Whether or not to reset the billing cycle\",\"enum\":[false,true],\"type\":\"boolean\"},\"couponRedemptionCode\":{\"description\":\"The coupon redemption code to apply to the plan change\",\"type\":\"string\"},\"effectiveDate\":{\"oneOf\":[{\"description\":\"The effective date of the plan change\",\"type\":\"object\"},{\"enum\":[\"end_of_subscription_term\",\"immediate\"],\"type\":\"string\"}]},\"externalPlanId\":{\"description\":\"The ID of the external plan to change to\",\"type\":\"string\"},\"orbSubscriptionId\":{\"description\":\"The ID of the Orb subscription to change\",\"type\":\"string\"},\"replacePrices\":{\"description\":\"The prices to replace in the subscription\",\"items\":{\"description\":\"The prices to replace in the subscription\",\"properties\":{\"fixedPriceQuantity\":{\"description\":\"The quantity for the fixed price\",\"type\":\"number\"},\"replacesPriceId\":{\"description\":\"The ID of the price to replace\",\"type\":\"string\"}},\"required\":[\"fixedPriceQuantity\",\"replacesPriceId\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"effectiveDate\",\"orbSubscriptionId\"],\"type\":\"object\"},\"output\":{\"properties\":{\"pendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change\",\"type\":\"string\"}},\"required\":[\"pendingSubscriptionChangeId\"],\"type\":\"object\"},\"type\":{\"enum\":[\"orb_plan_change\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"properties\":{\"add\":{\"description\":\"The price intervals to add to the subscription\",\"items\":{},\"type\":\"array\"},\"addAdjustments\":{\"description\":\"The adjustment intervals to add to the subscription\",\"items\":{},\"type\":\"array\"},\"allowInvoiceCreditOrVoid\":{\"description\":\"Whether to allow invoice credit or void\",\"enum\":[false,true],\"type\":\"boolean\"},\"edit\":{\"description\":\"The price intervals to edit on the subscription\",\"items\":{},\"type\":\"array\"},\"editAdjustments\":{\"description\":\"The adjustment intervals to edit on the subscription\",\"items\":{},\"type\":\"array\"},\"orbSubscriptionId\":{\"description\":\"The ID of the Orb subscription to modify price intervals for\",\"type\":\"string\"}},\"required\":[\"orbSubscriptionId\"],\"type\":\"object\"},\"output\":{\"properties\":{\"pendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change\",\"type\":\"string\"}},\"required\":[\"pendingSubscriptionChangeId\"],\"type\":\"object\"},\"type\":{\"enum\":[\"orb_price_interval\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"properties\":{\"addPrices\":{\"description\":\"The prices to add to the subscription\",\"items\":{\"oneOf\":[{\"description\":\"The prices to add to the subscription\",\"properties\":{\"priceId\":{\"description\":\"The ID of the price to add\",\"type\":\"string\"}},\"required\":[\"priceId\"],\"type\":\"object\"},{\"description\":\"The prices to add to the subscription\",\"type\":\"object\"}]},\"type\":\"array\"},\"alignBillingWithSubscriptionStartDate\":{\"description\":\"Whether to align the subscription start date with the billing subscription start date\",\"enum\":[false,true],\"type\":\"boolean\"},\"couponRedemptionCode\":{\"description\":\"The coupon redemption code to apply to the subscription\",\"type\":\"string\"},\"externalPlanId\":{\"description\":\"The external plan ID of the Orb plan to subscribe to\",\"type\":\"string\"},\"initialPhaseOrder\":{\"description\":\"The initial phase order to use for the subscription\",\"type\":\"number\"},\"metadata\":{\"additionalProperties\":{\"description\":\"Optional metadata to associate with the subscription\",\"nullable\":true,\"type\":\"string\"},\"description\":\"Optional metadata to associate with the subscription\",\"type\":\"object\"},\"removePrices\":{\"description\":\"The prices to remove in the subscription\",\"items\":{\"description\":\"The prices to remove in the subscription\",\"properties\":{\"priceId\":{\"description\":\"The ID of the price to remove\",\"type\":\"string\"}},\"required\":[\"priceId\"],\"type\":\"object\"},\"type\":\"array\"},\"replacePrices\":{\"description\":\"The prices to replace in the subscription\",\"items\":{\"description\":\"The prices to replace in the subscription\",\"properties\":{\"fixedPriceQuantity\":{\"description\":\"The quantity for the fixed price\",\"type\":\"number\"},\"replacesPriceId\":{\"description\":\"The ID of the price to replace\",\"type\":\"string\"}},\"required\":[\"fixedPriceQuantity\",\"replacesPriceId\"],\"type\":\"object\"},\"type\":\"array\"},\"startDate\":{\"description\":\"The start date of the subscription\",\"type\":\"string\"}},\"required\":[\"externalPlanId\"],\"type\":\"object\"},\"output\":{\"properties\":{\"pendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change\",\"type\":\"string\"}},\"required\":[\"pendingSubscriptionChangeId\"],\"type\":\"object\"},\"type\":{\"enum\":[\"orb_subscription\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"properties\":{\"lineItems\":{\"description\":\"The line items that make up the Purchase Intent.\",\"items\":{\"description\":\"The line items that make up the Purchase Intent.\",\"properties\":{\"description\":{\"description\":\"The description of the line item\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the line item\",\"type\":\"string\"},\"metadata\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Optional metadata for the line item\",\"type\":\"object\"},\"name\":{\"description\":\"The name of the line item\",\"type\":\"string\"},\"productAlias\":{\"description\":\"The alias of the product being purchased\",\"type\":\"string\"},\"productId\":{\"description\":\"The ID of the product being purchased\",\"type\":\"string\"},\"quantity\":{\"description\":\"The quantity of the line item\",\"type\":\"string\"},\"refund\":{\"description\":\"The amount of the line item that has been refunded\",\"type\":\"string\"},\"unitAmount\":{\"description\":\"The unit amount of the line item\",\"type\":\"string\"}},\"required\":[\"description\",\"id\",\"name\",\"productId\",\"quantity\",\"unitAmount\"],\"type\":\"object\"},\"type\":\"array\"},\"orbCustomerId\":{\"description\":\"The ID of the Orb customer to create\",\"type\":\"string\"},\"orbExternalCustomerId\":{\"description\":\"The external ID of the Orb customer to create\",\"type\":\"string\"},\"orbExternalPlanId\":{\"description\":\"The external ID of the Orb plan to create\",\"type\":\"string\"},\"orbPendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change\",\"type\":\"string\"},\"orbPlanId\":{\"description\":\"The ID of the Orb plan to create\",\"type\":\"string\"},\"orbSubscriptionId\":{\"description\":\"The ID of the Orb subscription to create\",\"type\":\"string\"}},\"required\":[\"orbCustomerId\",\"orbExternalCustomerId\",\"orbExternalPlanId\",\"orbPlanId\",\"orbSubscriptionId\"],\"type\":\"object\"},\"output\":{\"properties\":{\"pendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"enum\":[\"orb_subscription_intent\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"The configuration for a credit purchase\",\"properties\":{\"options\":{\"description\":\"Purchase configuration specific options\",\"properties\":{\"fromPlan\":{\"description\":\"The current plan being replaced by this purchase\",\"properties\":{\"currentCycleEndDate\":{\"description\":\"The end of the current plan billing cycle\",\"type\":\"string\"},\"orbSubscriptionId\":{\"description\":\"The Orb subscription ID currently active for the owner on the source plan\",\"type\":\"string\"},\"planId\":{\"description\":\"The ID of the plan currently assigned\",\"type\":\"string\"},\"planItemQuantities\":{\"description\":\"The current plan item quantities\",\"items\":{\"description\":\"The current plan item quantities\",\"properties\":{\"planItemId\":{\"description\":\"The ID of the current plan item to set the quantity for\",\"type\":\"string\"},\"quantity\":{\"description\":\"The nonnegative integer quantity for the current plan item\",\"type\":\"number\"},\"resourceIds\":{\"description\":\"The resource IDs associated with the current plan item quantity\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"planItemId\",\"quantity\"],\"type\":\"object\"},\"type\":\"array\"},\"rateVariantKey\":{\"description\":\"The rate variant currently assigned\",\"type\":\"string\"}},\"required\":[\"currentCycleEndDate\",\"orbSubscriptionId\",\"planId\"],\"type\":\"object\"},\"planId\":{\"description\":\"The ID of the plan to subscribe to\",\"type\":\"string\"},\"planItemQuantities\":{\"description\":\"The plan item quantities to set for the subscription\",\"items\":{\"description\":\"The plan item quantities to set for the subscription\",\"properties\":{\"planItemId\":{\"description\":\"The ID of the plan item to set the quantity for\",\"type\":\"string\"},\"quantity\":{\"description\":\"The nonnegative integer quantity for the plan item\",\"type\":\"number\"},\"resourceIds\":{\"description\":\"The resource IDs to associate with the plan item quantity\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"planItemId\",\"quantity\"],\"type\":\"object\"},\"type\":\"array\"},\"rateVariantKey\":{\"description\":\"The rate variant key to apply to the subscription\",\"type\":\"string\"}},\"required\":[\"planId\"],\"type\":\"object\"},\"output\":{\"properties\":{\"planChangeId\":{\"description\":\"The committed Plan revision used to calculate the purchase price\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":{\"enum\":[\"subscription\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"}]},\"createdAt\":{\"description\":\"The datetime when the Purchase Intent was created.\",\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the purchase intent\",\"enum\":[\"miu\",\"usd\"],\"type\":\"string\"},\"dispute\":{\"description\":\"The dispute details, if any.\",\"properties\":{\"amount\":{\"description\":\"The disputed amount.\",\"type\":\"string\"},\"createdAt\":{\"description\":\"When the dispute was first recorded.\",\"type\":\"string\"},\"currency\":{\"description\":\"The dispute currency.\",\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the dispute entity.\",\"type\":\"string\"},\"providerId\":{\"description\":\"The external provider dispute ID (e.g. Stripe dispute ID).\",\"type\":\"string\"},\"reason\":{\"description\":\"The dispute reason.\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"description\":\"The dispute status.\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"When the dispute was last updated.\",\"type\":\"string\"}},\"required\":[\"amount\",\"createdAt\",\"currency\",\"id\",\"providerId\",\"reason\",\"status\",\"updatedAt\"],\"type\":\"object\"},\"id\":{\"description\":\"The unique ID of a Purchase Intent. Uses the format `pur_*`\",\"type\":\"string\"},\"lineItems\":{\"description\":\"The line items that make up the Purchase Intent.\",\"items\":{\"description\":\"The line items that make up the Purchase Intent.\",\"properties\":{\"description\":{\"description\":\"The description of the line item\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the line item\",\"type\":\"string\"},\"metadata\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Optional metadata for the line item\",\"type\":\"object\"},\"name\":{\"description\":\"The name of the line item\",\"type\":\"string\"},\"productAlias\":{\"description\":\"The alias of the product being purchased\",\"type\":\"string\"},\"productId\":{\"description\":\"The ID of the product being purchased\",\"type\":\"string\"},\"quantity\":{\"description\":\"The quantity of the line item\",\"type\":\"string\"},\"refund\":{\"description\":\"The amount of the line item that has been refunded\",\"type\":\"string\"},\"unitAmount\":{\"description\":\"The unit amount of the line item\",\"type\":\"string\"}},\"required\":[\"description\",\"id\",\"name\",\"productId\",\"quantity\",\"unitAmount\"],\"type\":\"object\"},\"type\":\"array\"},\"metadata\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Optional metadata associated with the purchase intent\",\"type\":\"object\"},\"ownerId\":{\"description\":\"The ID of the owner of the Purchase Intent.\",\"type\":\"string\"},\"provider\":{\"properties\":{\"currencyConversionRate\":{\"description\":\"The currency conversion rate used by the provider\",\"type\":\"string\"},\"resourceId\":{\"description\":\"Provider resource id\",\"type\":\"string\"},\"stripeSharedPaymentTokenUsed\":{\"description\":\"Whether a Stripe Shared Payment Token was used for this purchase. Only applicable when type is stripe_invoice_immediate.\",\"enum\":[false,true],\"type\":\"boolean\"},\"type\":{\"description\":\"The type of the purchase provider\",\"enum\":[\"apple_in_app_purchase\",\"orb_ledger\",\"stripe_elements\",\"stripe_hosted\",\"stripe_invoice_deferred\",\"stripe_invoice_elements\",\"stripe_invoice_immediate\",\"tackle_aws_marketplace\"],\"type\":\"string\"}},\"required\":[\"resourceId\",\"type\"],\"type\":\"object\"},\"refund\":{\"description\":\"The amount of the purchase intent that has been refunded\",\"type\":\"string\"},\"returnUrl\":{\"description\":\"The URL to redirect to after the purchase is complete\",\"type\":\"string\"},\"status\":{\"description\":\"The status of the Purchase Intent.\",\"enum\":[\"failed\",\"pending\",\"succeeded\"],\"type\":\"string\"},\"subtotal\":{\"description\":\"The subtotal of the Purchase Intent.\",\"type\":\"string\"},\"tax\":{\"description\":\"The tax due on the Purchase Intent.\",\"type\":\"string\"},\"total\":{\"description\":\"The total balance due on the Purchase Intent.\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"The datetime when the Purchase Intent was last updated.\",\"type\":\"string\"}},\"required\":[\"configuration\",\"createdAt\",\"currency\",\"id\",\"ownerId\",\"provider\",\"status\",\"subtotal\",\"tax\",\"total\",\"updatedAt\"],\"type\":\"object\"}},\"required\":[\"purchaseIntent\"],\"type\":\"object\"},{\"properties\":{\"orbSubscriptionIntent\":{\"properties\":{\"configuration\":{\"oneOf\":[{\"description\":\"Configuration for the Orb subscription intent.\",\"properties\":{\"options\":{\"description\":\"Configuration input options for setting plan item quantity.\",\"properties\":{\"productAlias\":{\"description\":\"The alias of the product to set quantity for.\",\"type\":\"string\"},\"quantity\":{\"description\":\"The quantity to set for the plan item.\",\"type\":\"number\"},\"resourceIds\":{\"description\":\"The resource IDs for the plan item. Only set if SKU requires resource entitlements.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"productAlias\",\"quantity\"],\"type\":\"object\"},\"output\":{\"description\":\"Output returned after configuring an OrbSubscriptionIntent.\",\"properties\":{\"changedResources\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"items\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"properties\":{\"addedResourceIds\":{\"description\":\"Resource IDs that were added.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"effectiveAt\":{\"description\":\"When this resource change should take effect for downstream consumers.\",\"type\":\"string\"},\"productAlias\":{\"description\":\"The alias of the product that was changed.\",\"type\":\"string\"},\"productId\":{\"description\":\"The ID of the product that was changed.\",\"type\":\"string\"},\"quantity\":{\"description\":\"The resulting quantity after this change.\",\"type\":\"number\"},\"removedResourceIds\":{\"description\":\"Resource IDs that were removed.\",\"items\":{\"type\":\"string\"},\