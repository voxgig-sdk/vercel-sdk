rb\"],\"type\":\"string\"},\"productId\":{\"description\":\"The product ID associated with this intent.\",\"type\":\"string\"}},\"required\":[\"effectiveBehavior\",\"orbPriceId\",\"pricingSource\",\"productId\"],\"type\":\"object\"},\"type\":{\"enum\":[\"increase_plan_item_quantity\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"},{\"description\":\"Configuration for the Orb subscription intent.\",\"properties\":{\"options\":{\"description\":\"Configuration input options for decreasing plan item quantity.\",\"properties\":{\"productAlias\":{\"description\":\"The alias of the product to decrease quantity for.\",\"type\":\"string\"},\"resourceIds\":{\"description\":\"The resource IDs to decrementally remove. The quantity of the plan item will be decreased by the number of resource IDs.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"productAlias\",\"resourceIds\"],\"type\":\"object\"},\"output\":{\"description\":\"Output returned after configuring an OrbSubscriptionIntent.\",\"properties\":{\"changedResources\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"items\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"properties\":{\"addedResourceIds\":{\"description\":\"Resource IDs that were added.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"effectiveAt\":{\"description\":\"When this resource change should take effect for downstream consumers.\",\"type\":\"string\"},\"productAlias\":{\"description\":\"The alias of the product that was changed.\",\"type\":\"string\"},\"productId\":{\"description\":\"The ID of the product that was changed.\",\"type\":\"string\"},\"quantity\":{\"description\":\"The resulting quantity after this change.\",\"type\":\"number\"},\"removedResourceIds\":{\"descrip