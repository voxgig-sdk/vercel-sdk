mentally remove. The quantity of the plan item will be decreased by the number of resource IDs.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"addedResourceIds\",\"productAlias\",\"removedResourceIds\"],\"type\":\"object\"},\"output\":{\"description\":\"Output returned after configuring an OrbSubscriptionIntent.\",\"properties\":{\"changedResources\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"items\":{\"description\":\"Resources that were changed as part of this intent. Tracks all logical changes including the primary change and any side effects.\",\"properties\":{\"addedResourceIds\":{\"description\":\"Resource IDs that were added.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"effectiveAt\":{\"description\":\"When this resource change should take effect for downstream consumers.\",\"type\":\"string\"},\"productAlias\":{\"description\":\"The alias of the product that was changed.\",\"type\":\"string\"},\"productId\":{\"description\":\"The ID of the product that was changed.\",\"type\":\"string\"},\"quantity\":{\"description\":\"The resulting quantity after this change.\",\"type\":\"number\"},\"removedResourceIds\":{\"description\":\"Resource IDs that were removed.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"resourceIds\":{\"description\":\"The full set of resource IDs after the change.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"productAlias\",\"productId\",\"quantity\"],\"type\":\"object\"},\"type\":\"array\"},\"effectiveBehavior\":{\"description\":\"When the subscription change should take effect.\",\"enum\":[\"end_of_term\",\"immediate\"],\"type\":\"string\"},\"metadata\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Optional metadata associated with the intent to update the Orb subscription with.\",\"type\":\"object\"},\"orbPriceId\":{\"description\":\"The Orb price ID for the subscription item being modified.\",\"type\":\"string\"},\"pendingSubscriptionChangeId\":{\"description\":\"The ID of the pending subscription change if there is one.\",\"type\":\"string\"},\"pricingSource\":{\"description\":\"The source used as the authoritative price for this intent.\",\"enum\":[\"copper\",\"orb\"],\"type\":\"string\"},\"productId\":{\"description\":\"The product ID associated with this intent.\",\"type\":\"string\"}},\"required\":[\"effectiveBehavior\",\"orbPriceId\",\"pricingSource\",\"productId\"],\"type\":\"object\"},\"type\":{\"enum\":[\"adjust_plan_item_quantity\"],\"type\":\"string\"}},\"required\":[\"options\",\"output\",\"type\"],\"type\":\"object\"}]},\"createdAt\":{\"description\":\"The ISO 8601 date-time that the intent was created.\",\"type\":\"string\"},\"id\":{\"description\":\"The ID of the Orb subscription intent with the format `orbsubint_`.\",\"type\":\"string\"},\"orbSubscriptionId\":{\"description\":\"The Orb subscription ID this intent is associated with.\",\"type\":\"string\"},\"orbUpdate\":{\"oneOf\":[{\"description\":\"How the subscription change is applied to Orb.\",\"properties\":{\"mode\":{\"enum\":[\"sync\"],\"type\":\"string\"}},\"required\":[\"mode\"],\"type\":\"object\"},{\"description\":\"How the subscription change is applied to Orb.\",\"properties\":{\"mode\":{\"enum\":[\"async\"],\"type\":\"string\"},\"status\":{\"enum\":[\"canceled\",\"failed\",\"pending\",\"running\"],\"type\":\"string\"}},\"required\":[\"mode\",\"status\"],\"type\":\"object\"},{\"description\":\"How the subscription change is applied to Orb.\",\"properties\":{\"appliedAt\":{\"description\":\"The ISO 8601 date-time that the subscription change was applied to Orb.\",\"type\":\"string\"},\"mode\":{\"enum\":[\"async\"],\"type\":\"string\"},\"status\":{\"enum\":[\"succeeded\"],\"type\":\"string\"}},\"required\":[\"appliedAt\",\"mode\",\"status\"],\"type\":\"object\"}]},\"ownerId\":{\"description\":\"The owner ID for this intent (e.g