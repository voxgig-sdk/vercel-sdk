            id: "GET /v1/billing/charges"
            json: "{\"operationId\":\"listBillingCharges\",\"parameters\":[{\"description\":\"Inclusive start of the date range as an ISO 8601 date-time string in UTC.\",\"in\":\"query\",\"name\":\"from\",\"required\":true,\"schema\":{\"description\":\"Inclusive start of the date range as an ISO 8601 date-time string in UTC.\",\"example\":\"2025-01-01T00:00:00.000Z\",\"type\":\"string\"}},{\"description\":\"Exclusive end of the date range as an ISO 8601 date-time string in UTC.\",\"in\":\"query\",\"name\":\"to\",\"required\":true,\"schema\":{\"description\":\"Exclusive end of the date range as an ISO 8601 date-time string in UTC.\",\"example\":\"2025-01-31T00:00:00.000Z\",\"type\":\"string\"}},{\"description\":\"The Team identifier to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"teamId\",\"schema\":{\"example\":\"team_1a2b3c4d5e6f7g8h9i0j1k2l\",\"type\":\"string\"}},{\"description\":\"The Team slug to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"slug\",\"schema\":{\"example\":\"my-team-url-slug\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/jsonl\":{\"schema\":{\"description\":\"Extension of the base schema for Focus charges. Includes pricing information for all customers.\",\"properties\":{\"BilledCost\":{\"description\":\"Charge amount serving as the basis for invoicing\",\"type\":\"number\"},\"BillingCurrency\":{\"description\":\"Currency used for billing (ISO 4217)\",\"enum\":[\"USD\"],\"type\":\"string\"},\"ChargeCategory\":{\"description\":\"Classification of the charge\",\"enum\":[\"Adjustment\",\"Credit\",\"Purchase\",\"Tax\",\"Usage\"],\"type\":\"string\"},\"ChargePeriodEnd\":{\"description\":\"Exclusive end of the charge period (ISO 8601 UTC) - Required in v1.3\",\"type\":\"string\"},\"ChargePeriodStart\":{\"description\":\"Inclusive start of the charge period (ISO 8601 UTC)\",\"type\":\"string\"},\"ConsumedQuantity\":{\"description\":\"Volume of resource consumed. Null when a charge does not involve measurable consumption quantity.\",\"nullable\":true,\"type\":\"number\"},\"ConsumedUnit\":{\"description\":\"Unit of measurement for consumed quantity. Null when the charge is not measured in units.\",\"nullable\":true,\"type\":\"string\"},\"EffectiveCost\":{\"description\":\"Amortized cost representation including discounts, pre-commitment credit purchase amount, etc.\",\"type\":\"number\"},\"PricingCategory\":{\"description\":\"Pricing model used for the charge.\",\"enum\":[\"Committed\",\"Dynamic\",\"Other\",\"Standard\"],\"type\":\"string\"},\"PricingCurrency\":{\"enum\":[\"USD\"],\"type\":\"string\"},\"PricingQuantity\":{\"type\":\"number\"},\"PricingUnit\":{\"type\":\"string\"},\"RegionId\":{\"description\":\"Provider-assigned region identifier\",\"type\":\"string\"},\"RegionName\":{\"description\":\"Display name for the region\",\"type\":\"string\"},\"ServiceCategory\":{\"description\":\"High-level category of the service\",\"enum\":[\"AI and Machine Learning\",\"Analytics\",\"Business Applications\",\"Compute\",\"Databases\",\"Developer Tools\",\"Identity\",\"Integration\",\"Internet of Things\",\"Management and Governance\",\"Media\",\"Migration\",\"Mobile\",\"Multicloud\",\"Networking\",\"Other\",\"Security\",\"Storage\",\"Web\"],\"type\":\"string\"},\"ServiceName\":{\"description\":\"Display name for the service/product\",\"type\":\"string\"},\"ServiceProviderName\":{\"description\":\"Entity making the resource/service available for purchase (v1.3)\",\"type\":\"string\"},\"Tags\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Charge metadata including the Vercel ProjectId and ProjectName information\",\"type\":\"object\"}},\"required\":[\"BilledCost\",\"BillingCurrency\",\"ChargeCategory\",\"ChargePeriodEnd\",\"ChargePeriodStart\",\"ConsumedQuantity\",\"ConsumedUnit\",\"EffectiveCost\",\"PricingCategory\",\"PricingCurrency\",\"PricingQuantity\",\"PricingUnit\",\"ServiceName\",\"ServiceProviderName\",\"Tags\"],\"type\":\"object\"}}},\"description\":\"\"},\"400\":{\"description\":\"One of the provided values in the request query is invalid.\"},\"401\":{\"description\":\"The request is not authorized.\"},\"403\":{\"description\":\"You do not have permission to access this resource.\"},\"404\":{\"description\":\"\"},\"410\":{\"description\":\"\"},\"500\":{\"description\":\"\"},\"503\":{\"description\":\"\"}},\"security\":[{\"bearerToken\":[]}],\"securitySchemes\":{\"bearerToken\":{\"description\":\"Default authentication mechanism\",\"scheme\":\"bearer\",\"type\":\"http\"},\"oauth2\":{\"flows\":{\"authorizationCode\":{\"authorizationUrl\":\"https://api.vercel.com/oauth/authorize\",\"scopes\":{},\"tokenUrl\":\"https://api.vercel.com/oauth/access_token\"}},\"type\":\"oauth2\"}},\"securitySource\":\"operation\"}"
