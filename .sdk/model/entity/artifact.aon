          select: {
            exist: [
              "content_length"
              "id"
              "slug"
              "team_id"
              "x_artifact_client_ci"
              "x_artifact_client_interactive"
              "x_artifact_dirty_hash"
              "x_artifact_duration"
              "x_artifact_sha"
              "x_artifact_tag"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
