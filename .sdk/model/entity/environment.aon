# Entity: environment

main: kit: entity: environment: {

  alias: field: {}

  fields: [
    {
      name: "branchMatcher"
      req: true
      short: "Configuration for matching git branches to this environment"
      type: "`$OBJECT`"
    }
    {
      name: "copyEnvVarsFrom"
      req: false
      short: "Where to copy environment variables from."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Timestamp when the environment was created"
      type: "`$NUMBER`"
    }
    {
      name: "currentDeploymentAliases"
      req: false
      short: "List of aliases for the current deployment"
      type: "`$ARRAY`"
    }
    {
      name: "description"
      req: false
      short: "Optional description of the environment's purpose"
      type: "`$STRING`"
    }
    {
      name: "domains"
      req: false
      short: "List of domains associated with this environment"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: true
      short: "Unique identifier for the custom environment (format: env_*)"
      type: "`$STRING`"
    }
    {
      name: "slug"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "URL-friendly name of the environment"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "The type of environment (production, preview, or development)"
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Timestamp when the environment was last updated"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

