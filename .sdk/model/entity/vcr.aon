# Entity: vcr

main: kit: entity: vcr: {

  alias: field: {}

  fields: [
    {
      name: "arch"
      req: false
      short: "CPU architecture the manifest targets."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "ISO 8601 timestamp of when the image was created."
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Internal identifier of the image."
      type: "`$STRING`"
    }
    {
      name: "imageId"
      req: true
      short: "Internal identifier of the image the tag points at."
      type: "`$STRING`"
    }
    {
      name: "kind"
      req: true
      short: "Whether the manifest is a multi-platform image index, a single-platform image manifest or an attestation."
      type: "`$STRING`"
    }
    {
      name: "layers"
      req: true
      type: "`$ARRAY`"
      union: {
        branches: 4
        count: 1
        depth: 1
      }
    }
    {
      name: "manifestDigest"
      req: true
      short: "SHA-256 digest of the image manifest."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Name of the repository."
      type: "`$STRING`"
    }
    {
      name: "platform"
      req: false
      short: "Operating system the manifest targets."
      type: "`$STRING`"
    }
    {
      name: "projectId"
      req: true
      short: "Identifier of the project the repository belongs to."
      type: "`$STRING`"
    }
    {
      name: "public"
      req: true
      short: "Whether the repository is public."
      type: "`$BOOLEAN`"
    }
    {
      name: "pushedBy"
      req: false
      short: "Identifier of the actor that pushed the image."
      type: "`$STRING`"
    }
    {
      name: "repositoryId"
      req: true
      short: "Identifier of the repository the image belongs to."
      type: "`$STRING`"
    }
    {
      name: "sizeInBytes"
      req: true
      short: "Total size in bytes of the image's resources (manifest, config and layer blobs) stored by the registry."
      type: "`$NUMBER`"
    }
    {
      name: "status"
      req: true
      short: "VHS-readiness status, or `null` for a multi-platform index."
      type: "`$STRING`"
    }
    {
      name: "tag"
      req: true
      short: "The tag name."
      type: "`$STRING`"
    }
    {
      name: "tags"
      req: true
      short: "Tags pointing at this image's manifest."
      type: "`$ARRAY`"
    }
    {
      name: "teamId"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Identifier of the team that is granted access to the repository."
      type: "`$STRING`"
    }
    {
      name: "teamSlug"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Slug of the team that is granted access to the repository."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "ISO 8601 timestamp of when the tag was last updated."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

