# Entity: connect_project_connection

main: kit: entity: connect_project_connection: {

  alias: field: {}

  fields: [
    {
      name: "connectorId"
      req: true
      short: "Stable `scl_` connector ID, even when the request used a UID."
      type: "`$STRING`"
    }
    {
      name: "createdAt"
      req: true
      short: "Time when the project connection was created, in epoch milliseconds."
      type: "`$NUMBER`"
    }
    {
      name: "enabledEnvironments"
      req: true
      short: "Environments where the connector is enabled for the project."
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    {
      name: "environments"
      req: true
      short: "One or more built-in environment names or stable custom environment IDs that belong to the project."
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    {
      name: "project"
      req: true
      short: "Vercel project connected to the connector."
      type: "`$OBJECT`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Time when the project connection was last updated, in epoch milliseconds."
      type: "`$NUMBER`"
    }
  ]

