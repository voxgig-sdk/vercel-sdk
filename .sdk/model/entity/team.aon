ks requires Owner role.\",\"properties\":{\"enabled\":{\"description\":\"Enable or disable requiring Owner role to create shareable links.\",\"example\":true,\"type\":\"boolean\"}},\"required\":[\"enabled\"],\"type\":\"object\"}},\"type\":\"object\"}}},\"required\":true},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":true,\"description\":\"Data representing a Team.\",\"properties\":{\"apiKeysInvalidatedAt\":{\"description\":\"Timestamp (ms) after which API keys created at or before this time are considered invalid for this team.\",\"type\":\"number\"},\"appTokensInvalidatedAt\":{\"description\":\"Timestamp (ms) after which Vercel App tokens created at or before this time are considered invalid for this team.\",\"type\":\"number\"},\"avatar\":{\"description\":\"The ID of the file used as avatar for this Team.\",\"example\":\"6eb07268bcfadd309905ffb1579354084c24655c\",\"nullable\":true,\"type\":\"string\"},\"billing\":{\"description\":\"The team's billing plan.\",\"nullable\":true,\"properties\":{\"plan\":{\"enum\":[\"enterprise\",\"hobby\",\"pro\"],\"type\":\"string\"}},\"required\":[\"plan\"],\"type\":\"object\"},\"connect\":{\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"}},\"type\":\"object\"},\"createdAt\":{\"description\":\"UNIX timestamp (in milliseconds) when the Team was created.\",\"example\":1630748523395,\"type\":\"number\"},\"creatorId\":{\"description\":\"The ID of the user who created the Team.\",\"example\":\"R6efeCJQ2HKXywuasPDc0fOWB\",\"type\":\"string\"},\"defaultDeploymentProtection\":{\"description\":\"Default deployment protection for this team null indicates protection is disabled\",\"properties\":{\"passwordProtection\":{\"nullable\":true,\"properties\":{\"deploymentType\":{\"type\":\"string\"}},\"required\":[\"deploymentType\"],\"type\":\"object\"},\"ssoProtection\":{\"nullable\":true,\"properties\":{\"deploymentType\":{\"type\":\"string\"}},\"required\":[\"deploymentType\"],\"type\":\"object\"}},\"type\":\"object\"},\"defaultExpirationSettings\":{\"description\":\"Default deployment expiration settings for this team\",\"properties\":{\"deploymentsToKeep\":{\"description\":\"Minimum number of production deployments to keep for this project, even if they are over the production expiration limit.\",\"type\":\"number\"},\"expirationDays\":{\"description\":\"Number of days to keep non-production deployments (mostly preview deployments) before soft deletion.\",\"type\":\"number\"},\"expirationDaysCanceled\":{\"description\":\"Number of days to keep canceled deployments before soft deletion.\",\"type\":\"number\"},\"expirationDaysErrored\":{\"description\":\"Number of days to keep errored deployments before soft deletion.\",\"type\":\"number\"},\"expirationDaysProduction\":{\"description\":\"Number of days to keep production deployments before soft deletion.\",\"type\":\"number\"}},\"type\":\"object\"},\"defaultPassport\":{\"description\":\"Default Passport configuration for new projects in this team.\",\"nullable\":true,\"properties\":{\"connectorId\":{\"description\":\"Default Passport configuration for new projects in this team.\",\"type\":\"string\"},\"deploymentType\":{\"description\":\"Default Passport configuration for new projects in this team.\",\"enum\":[\"all\",\"all_except_custom_domains\",\"preview\",\"prod_deployment_urls_and_all_previews\"],\"type\":\"string\"}},\"required\":[\"connectorId\",\"deploymentType\"],\"type\":\"object\"},\"defaultProjectJobs\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"properties\":{\"lint\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"properties\":{\"targets\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"targets\"],\"type\":\"object\"},\"mfe-config-present\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"properties\":{\"targets\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"targets\"],\"type\":\"object\"},\"typecheck\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"properties\":{\"targets\":{\"description\":\"Default job configuration applied to new projects created in this team.\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"targets\"],\"type\":\"object\"}},\"type\":\"object\"},\"defaultRoles\":{\"description\":\"Default roles for the team.\",\"properties\":{\"teamPermissions\":{\"items\":{\"enum\":[\"AiGatewayBudgetManager\",\"AiGatewayCredits\",\"AiGatewaySettings\",\"AiGatewayTranscriptsManager\",\"AiGatewayTranscriptsViewer\",\"AiGatewayUser\",\"ConnectorManager\",\"CreateProject\",\"EnvVariableManager\",\"EnvironmentManager\",\"FullProductionDeployment\",\"IntegrationManager\",\"OrgAdmin\",\"OrgViewer\",\"UsageViewer\",\"V0Builder\",\"V0Chatter\",\"V0Viewer\",\"WorkflowDecryptor\"],\"type\":\"string\"},\"type\":\"array\"},\"teamRoles\":{\"items\":{\"enum\":[\"BILLING\",\"CONTRIBUTOR\",\"DEVELOPER\",\"MEMBER\",\"OWNER\",\"SECURITY\",\"VIEWER\",\"VIEWER_FOR_PLUS\"],\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"},\"deploymentPolicy\":{\"description\":\"Composable deployment-time policy for the team. Used as the default for every project on the team, with optional per-project overrides on `project.deploymentPolicy`.\",\"properties\":{\"deploymentSources\":{\"items\":{\"description\":\"`enabled: true` with empty `sources` is deny-all.\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"environments\":{\"items\":{\"oneOf\":[{\"properties\":{\"target\":{\"enum\":[\"preview\",\"production\"],\"type\":\"string\"},\"type\":{\"enum\":[\"system\"],\"type\":\"string\"}},\"required\":[\"target\",\"type\"],\"type\":\"object\"},{\"properties\":{\"environmentId\":{\"type\":\"string\"},\"type\":{\"enum\":[\"custom\"],\"type\":\"string\"}},\"required\":[\"environmentId\",\"type\"],\"type\":\"object\"}]},\"type\":\"array\"},\"sources\":{\"items\":{\"description\":\"Customer-configurable deployment sources. Every deploy classifies to exactly one. JSON schema in `packages/deployment-policy/schemas/body.ts` enumerates exactly these values. - `'git'` — git provider webhook. - `'cli'` — Vercel CLI (legacy classic-token CLI and SIWV CLI both). - `'rest-api'` — direct user/team-token REST upload. Does NOT cover deploy hooks, Marketplace integrations, or first-party app tokens. - `'deploy-hook'` — project deploy-hook URL. The URL is the credential. - `'integration'` — third-party Marketplace actor: Marketplace integration token, user-delegated OAuth from a Marketplace app, or an unrecognized third-party Vercel App. First-party Vercel Apps are never `'integration'`. - `'v0'` — the v0 product surface (entitlement-gated). v0 deploys through the CLI under the hood, but classifies as its own source so a team can allow or deny v0 independently of `'cli'`. First-party Vercel apps (Toolbar, etc.) classify as `'first-party'` — see `ClassifiedSource` in `./checks`. They're not in this union because they aren't customer-configurable; they bypass `checkDeploymentSources` entirely. v0 is intentionally NOT among them: like the CLI, it's a real product surface and is policy-controllable.\",\"enum\":[\"cli\",\"deploy-hook\",\"git\",\"integration\",\"rest-api\",\"v0\"],\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"enabled\",\"environments\",\"sources\"],\"type\":\"object\"},\"type\":\"array\"},\"gitSources\":{\"items\":{\"description\":\"`enabled: true` with empty `sources` is deny-all.\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"environments\":{\"items\":{\"oneOf\":[{\"properties\":{\"target\":{\"enum\":[\"preview\",\"production\"],\"type\":\"string\"},\"type\":{\"enum\":[\"system\"],\"type\":\"string\"}},\"required\":[\"target\",\"type\"],\"type\":\"object\"},{\"properties\":{\"environmentId\":{\"type\":\"string\"},\"type\":{\"enum\":[\"custom\"],\"type\":\"string\"}},\"required\":[\"environmentId\",\"type\"],\"type\":\"object\"}]},\"type\":\"array\"},\"sources\":{\"items\":{\"oneOf\":[{\"description\":\"Allowlist entry for GitHub and Bitbucket, whose repos are identified by a flat `org`/`repo` (Bitbucket's workspace/owner maps to `org`, its repo slug to `repo`). Omit `repo` to match any repo in the org. Org is matched case-insensitively.\",\"properties\":{\"org\":{\"type\":\"string\"},\"provider\":{\"enum\":[\"bitbucket\",\"github\"],\"type\":\"string\"},\"repo\":{\"type\":\"string\"}},\"required\":[\"org\",\"provider\"],\"type\":\"object\"},{\"description\":\"Allowlist entry for GitLab, which uses nested groups rather than a flat org/repo. `namespace` is the full group path (e.g. `group` or `group/subgroup`); `project` is the leaf project name. Omit `project` to match any project under the namespace. Namespace is matched case-insensitively.\",\"properties\":{\"namespace\":{\"type\":\"string\"},\"project\":{\"type\":\"string\"},\"provider\":{\"enum\":[\"gitlab\"],\"type\":\"string\"}},\"required\":[\"namespace\",\"provider\"],\"type\":\"object\"}]},\"type\":\"array\"}},\"required\":[\"enabled\",\"environments\",\"sources\"],\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"},\"description\":{\"description\":\"A short description of the Team.\",\"example\":\"Our mission is to make cloud computing accessible to everyone.\",\"nullable\":true,\"type\":\"string\"},\"disableHardAutoBlocks\":{\"oneOf\":[{\"type\":\"number\"},{\"enum\":[false,true],\"type\":\"boolean\"}]},\"disableRepositoryDispatchEvents\":{\"description\":\"Default for projects in the team. When `true`, projects in this team will not emit GitHub repository-dispatch events on deployment events unless the project explicitly overrides this setting via `project.gitProviderOptions.disableRepositoryDispatchEvents`.\",\"enum\":[false,true],\"type\":\"boolean\"},\"disjunctiveProductionSecretPolicy\":{\"description\":\"Require production secrets to use a different value than preview or development.\",\"enum\":[\"default\",\"off\",\"on\",null],\"nullable\":true,\"type\":\"string\"},\"dpAccessRequestsMode\":{\"description\":\"Controls who can request access to protected deployments.\",\"enum\":[\"all\",\"email-domain\",\"none\"],\"type\":\"string\"},\"emailDomain\":{\"description\":\"Hostname that'll be matched with emails on sign-up to automatically join the Team.\",\"example\":\"example.com\",\"nullable\":true,\"type\":\"string\"},\"enablePreviewFeedback\":{\"description\":\"Whether toolbar is enabled on preview deployments\",\"enum\":[\"default\",\"default-force\",\"off\",\"off-force\",\"on\",\"on-force\",null],\"nullable\":true,\"type\":\"string\"},\"enableProductionFeedback\":{\"description\":\"Whether toolbar is enabled on production deployments\",\"enum\":[\"default\",\"default-force\",\"off\",\"off-force\",\"on\",\"on-force\",null],\"nullable\":true,\"type\":\"string\"},\"hideIpAddresses\":{\"description\":\"Indicates if IP addresses should be accessible in observability (o11y) tooling\",\"enum\":[false,true,null],\"nullable\":true,\"type\":\"boolean\"},\"hideIpAddressesInLogDrains\":{\"description\":\"Indicates if IP addresses should be accessible in log drains\",\"enum\":[false,true,null],\"nullable\":true,\"type\":\"boolean\"},\"id\":{\"description\":\"The Team's unique identifier.\",\"example\":\"team_nllPyCtREAqxxdyFKbbMDlxd\",\"type\":\"string\"},\"integrationTokensInvalidatedAt\":{\"description\":\"Timestamp (ms) after which integration tokens created at or before this time are considered invalid for this team.\",\"type\":\"number\"},\"inviteCode\":{\"description\":\"Code that can be used to join this Team. Only visible to Team owners.\",\"example\":\"hasihf9e89\",\"type\":\"string\"},\"ipBuckets\":{\"items\":{\"properties\":{\"bucket\":{\"type\":\"string\"},\"default\":{\"enum\":[false,true],\"type\":\"boolean\"},\"supportUntil\":{\"type\":\"number\"}},\"required\":[\"bucket\"],\"type\":\"object\"},\"type\":\"array\"},\"membership\":{\"description\":\"The membership of the authenticated User in relation to the Team.\",\"properties\":{\"accessRequestedAt\":{\"type\":\"number\"},\"confirmed\":{\"enum\":[true],\"type\":\"boolean\"},\"created\":{\"type\":\"number\"},\"createdAt\":{\"type\":\"number\"},\"entitlements\":{\"items\":{\"properties\":{\"entitlement\":{\"type\":\"string\"}},\"required\":[\"entitlement\"],\"type\":\"object\"},\"type\":\"array\"},\"joinedFrom\":{\"properties\":{\"commitId\":{\"type\":\"string\"},\"dsyncConnectedAt\":{\"type\":\"number\"},\"dsyncUserId\":{\"type\":\"string\"},\"gitUserId\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]},\"gitUserLogin\":{\"type\":\"string\"},\"idpUserId\":{\"type\":\"string\"},\"origin\":{\"enum\":[\"account-update\",\"bitbucket\",\"dsync\",\"feedback\",\"github\",\"gitlab\",\"import\",\"link\",\"mail\",\"nsnb-auto-approve\",\"nsnb-hobby-upgrade\",\"nsnb-invite\",\"nsnb-redeploy\",\"nsnb-redeploy-attribution-card\",\"nsnb-request-access\",\"nsnb-viewer-upgrade\",\"organization-teams\",\"saml\",\"teams\"],\"type\":\"string\"},\"repoId\":{\"type\":\"string\"},\"repoPath\":{\"type\":\"string\"},\"ssoConnectedAt\":{\"type\":\"number\"},\"ssoUserId\":{\"type\":\"string\"}},\"required\":[\"origin\"],\"type\":\"object\"},\"role\":{\"enum\":[\"BILLING\",\"CONTRIBUTOR\",\"DEVELOPER\",\"MEMBER\",\"OWNER\",\"SECURITY\",\"VIEWER\",\"VIEWER_FOR_PLUS\"],\"type\":\"string\"},\"teamId\":{\"type\":\"string\"},\"teamPermissions\":{\"items\":{\"enum\":[\"AiGatewayBudgetManager\",\"AiGatewayCredits\",\"AiGatewaySettings\",\"AiGatewayTranscriptsManager\",\"AiGatewayTranscriptsViewer\",\"AiGatewayUser\",\"ConnectorManager\",\"CreateProject\",\"EnvVariableManager\",\"EnvironmentManager\",\"FullProductionDeployment\",\"IntegrationManager\",\"OrgAdmin\",\"OrgViewer\",\"UsageViewer\",\"V0Builder\",\"V0Chatter\",\"V0Viewer\",\"WorkflowDecryptor\"],\"type\":\"string\"},\"type\":\"array\"},\"teamRoles\":{\"items\":{\"enum\":[\"BILLING\",\"CONTRIBUTOR\",\"DEVELOPER\",\"MEMBER\",\"OWNER\",\"SECURITY\",\"VIEWER\",\"VIEWER_FOR_PLUS\"],\"type\":\"string\"},\"type\":\"array\"},\"uid\":{\"type\":\"string\"}},\"required\":[\"confirmed\",\"created\",\"createdAt\",\"role\"],\"type\":\"object\"},\"name\":{\"description\":\"Name associated with the Team account, or `null` if none has been provided.\",\"example\":\"My Team\",\"nullable\":true,\"type\":\"string\"},\"nsnbConfig\":{\"description\":\"NSNB configuration for the team.\",\"properties\":{\"preference\":{\"enum\":[\"auto-approval\",\"block\",\"manual-approval\"],\"type\":\"string\"}},\"required\":[\"preference\"],\"type\":\"object\"},\"orgRootTeamId\":{\"description\":\"Best-effort ID of the organization’s root billing team. When present, compare `orgRootTeamId === id` to identify the root team. It may be omitted even when `parentId` is set if organization resolution fails or the referenced organization is missing. Always omitted for non-organization teams.\",\"example\":\"team_nllPyCtREAqxxdyFKbbMDlxd\",\"type\":\"string\"},\"parentId\":{\"description\":\"The organizationId for teams that belong to an organization (set on both the organization's root team and its child teams).\",\"example\":\"org_nllPyCtREAqxxdyFKbbMDlxd\",\"type\":\"string\"},\"personalAccessTokensInvalidatedAt\":{\"description\":\"Timestamp (ms) after which personal access tokens created at or before this time are considered invalid for this team.\",\"type\":\"number\"},\"platform\":{\"description\":\"Whether the team is a platform team.\",\"enum\":[false,true],\"example\":true,\"type\":\"boolean\"},\"previewDeploymentSuffix\":{\"description\":\"The hostname that is current set as preview deployment suffix.\",\"example\":\"example.dev\",\"nullable\":true,\"type\":\"string\"},\"remoteCaching\":{\"description\":\"Is remote caching enabled for this team\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"}},\"type\":\"object\"},\"requireVerifiedCommits\":{\"description\":\"When enabled, all projects in the team require commits to be signed and verified by the git provider before deployments will be created. Projects may override this via `project.gitProviderOptions.requireVerifiedCommits` (gated by `Project:Update`).\",\"enum\":[false,true],\"type\":\"boolean\"},\"resourceConfig\":{\"properties\":{\"blobStores\":{\"description\":\"The maximum number of blob stores an account can create.\",\"type\":\"number\"},\"buildEntitlements\":{\"properties\":{\"enhancedBuilds\":{\"enum\":[false,true],\"type\":\"boolean\"}},\"type\":\"object\"},\"buildMachine\":{\"description\":\"Build machine configuration\",\"properties\":{\"default\":{\"description\":\"Default build machine type for new builds\",\"enum\":[\"basic\",\"elastic\",\"enhanced\",\"standard\",\"turbo\"],\"type\":\"string\"}},\"type\":\"object\"},\"concurrentBuilds\":{\"description\":\"The total amount of concurrent builds that can be used.\",\"type\":\"number\"},\"customEnvironmentsPerProject\":{\"description\":\"The maximum number of custom environments allowed per project.\",\"type\":\"number\"},\"edgeConfigSize\":{\"description\":\"The maximum size in kilobytes of an Edge Config. Only specified if a custom limit is set.\",\"type\":\"number\"},\"edgeConfigs\":{\"description\":\"The maximum number of edge configs an account can create.\",\"type\":\"number\"},\"elasticConcurrencyEnabled\":{\"description\":\"Whether every build for this team / user has elastic concurrency enabled automatically.\",\"enum\":[false,true],\"type\":\"boolean\"},\"kvDatabases\":{\"description\":\"The maximum number of kv databases an account can create.\",\"type\":\"number\"},\"postgresDatabases\":{\"description\":\"The maximum number of postgres databases an account can create.\",\"type\":\"number\"},\"serverlessFunctionMaxMemorySize\":{\"description\":\"The maximum memory size (in MB) for a serverless function. Only specified if a custom limit is set.\",\"type\":\"number\"}},\"type\":\"object\"},\"saml\":{\"description\":\"When \\\"Single Sign-On (SAML)\\\" is configured, this object contains information regarding the configuration of the Identity Provider (IdP).\",\"properties\":{\"connection\":{\"description\":\"Information for the SAML Single Sign-On configuration.\",\"properties\":{\"connectedAt\":{\"description\":\"Timestamp (in milliseconds) of when the configuration was connected.\",\"example\":1611796915677,\"type\":\"number\"},\"lastReceivedWebhookEvent\":{\"description\":\"Timestamp (in milliseconds) of when the last webhook event was received from WorkOS.\",\"example\":1611796915677,\"type\":\"number\"},\"lastSyncedAt\":{\"description\":\"Timestamp (in milliseconds) of when the last directory sync was performed.\",\"example\":1611796915677,\"type\":\"number\"},\"state\":{\"description\":\"Current state of the connection.\",\"example\":\"active\",\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"syncState\":{\"description\":\"Controls whether directory sync events are processed. - 'SETUP': Directory connected but role mappings not yet configured. Events are acknowledged but not processed. - 'ACTIVE': Fully configured. Events are processed normally. - undefined: Legacy directory (pre-feature), treat as 'ACTIVE' for backwards compatibility.\",\"enum\":[\"ACTIVE\",\"SETUP\"],\"type\":\"string\"},\"type\":{\"description\":\"The Identity Provider \\\"type\\\", for example Okta.\",\"example\":\"OktaSAML\",\"type\":\"string\"}},\"required\":[\"connectedAt\",\"state\",\"status\",\"type\"],\"type\":\"object\"},\"defaultRedirectUri\":{\"description\":\"The default redirect URI to use after successful SAML authentication.\",\"enum\":[\"v0.app\",\"v0.dev\",\"vercel.com\"],\"type\":\"string\"},\"directory\":{\"description\":\"Information for the Directory Sync configuration.\",\"properties\":{\"connectedAt\":{\"description\":\"Timestamp (in milliseconds) of when the configuration was connected.\",\"example\":1611796915677,\"type\":\"number\"},\"lastReceivedWebhookEvent\":{\"description\":\"Timestamp (in milliseconds) of when the last webhook event was received from WorkOS.\",\"example\":1611796915677,\"type\":\"number\"},\"lastSyncedAt\":{\"description\":\"Timestamp (in milliseconds) of when the last directory sync was performed.\",\"example\":1611796915677,\"type\":\"number\"},\"state\":{\"description\":\"Current state of the connection.\",\"example\":\"active\",\"type\":\"string\"},\"syncState\":{\"description\":\"Controls whether directory sync events are processed. - 'SETUP': Directory connected but role mappings not yet configured. Events are acknowledged but not processed. - 'ACTIVE': Fully configured. Events are processed normally. - undefined: Legacy directory (pre-feature), treat as 'ACTIVE' for backwards compatibility.\",\"enum\":[\"ACTIVE\",\"SETUP\"],\"type\":\"string\"},\"type\":{\"description\":\"The Identity Provider \\\"type\\\", for example Okta.\",\"example\":\"OktaSAML\",\"type\":\"string\"}},\"required\":[\"connectedAt\",\"state\",\"type\"],\"type\":\"object\"},\"enforced\":{\"description\":\"When `true`, interactions with the Team **must** be done with an authentication token that has been authenticated with the Team's SAML Single Sign-On provider.\",\"enum\":[false,true],\"type\":\"boolean\"},\"roles\":{\"additionalProperties\":{\"oneOf\":[{\"description\":\"When \\\"Directory Sync\\\" is configured, this object contains a mapping of which Directory Group (by ID) should be assigned to which Vercel Team \\\"role\\\".\",\"properties\":{\"accessGroupId\":{\"type\":\"string\"}},\"required\":[\"accessGroupId\"],\"type\":\"object\"},{\"enum\":[\"BILLING\",\"CONTRIBUTOR\",\"DEVELOPER\",\"MEMBER\",\"OWNER\",\"SECURITY\",\"VIEWER\",\"VIEWER_FOR_PLUS\"],\"type\":\"string\"}]},\"description\":\"When \\\"Directory Sync\\\" is configured, this object contains a mapping of which Directory Group (by ID) should be assigned to which Vercel Team \\\"role\\\".\",\"type\":\"object\"}},\"required\":[\"enforced\"],\"type\":\"object\"},\"sensitiveEnvironmentVariablePolicy\":{\"description\":\"Sensitive environment variable policy for this team\",\"enum\":[\"default\",\"off\",\"on\",null],\"nullable\":true,\"type\":\"string\"},\"slug\":{\"description\":\"The Team's slug, which is unique across the Vercel platform.\",\"example\":\"my-team\",\"type\":\"string\"},\"stagingPrefix\":{\"description\":\"The prefix that is prepended to automatic aliases.\",\"type\":\"string\"},\"strictConnectors\":{\"description\":\"When enabled, creating and managing connectors requires Owner role or the ConnectorManager permission.\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"updatedAt\":{\"type\":\"number\"}},\"required\":[\"enabled\",\"updatedAt\"],\"type\":\"object\"},\"strictDeploymentProtectionSettings\":{\"description\":\"When enabled, deployment protection settings require stricter permissions (owner-only).\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"updatedAt\":{\"type\":\"number\"}},\"required\":[\"enabled\",\"updatedAt\"],\"type\":\"object\"},\"strictPasswordProtectionSettings\":{\"description\":\"When enabled, adding, changing, or removing project password protection requires Owner role.\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"updatedAt\":{\"type\":\"number\"}},\"required\":[\"enabled\",\"updatedAt\"],\"type\":\"object\"},\"strictShareableLinks\":{\"description\":\"When enabled, creating shareable links requires Owner role.\",\"properties\":{\"enabled\":{\"enum\":[false,true],\"type\":\"boolean\"},\"updatedAt\":{\"type\":\"number\"}},\"required\":[\"enabled\",\"updatedAt\"],\"type\":\"object\"},\"updatedAt\":{\"description\":\"Timestamp (in milliseconds) of when the Team was last updated.\",\"example\":1611796915677,\"type\":\"number\"}},\"required\":[\"avatar\",\"billing\",\"createdAt\",\"creatorId\",\"description\",\"id\",\"name\",\"slug\",\"stagingPrefix\",\"updatedAt\"],\"type\":\"object\"}}},\"description\":\"\"},\"400\":{\"description\":\"One of the provided values in the request body is invalid.\"},\"401\":{\"description\":\"The request is not authorized.\"},\"402\":{\"description\":\"\"},\"403\":{\"description\":\"You do not have permission to access this resource.\\nNot authorized to update the team. Must be an OWNER.\"},\"410\":{\"description\":\"\"},\"428\":{\"description\":\"\"}},\"security\":[{\"bearerToken\":[]}],\"securitySchemes\":{\"bearerToken\":{\"description\":\"Default authentication mechanism\",\"scheme\":\"bearer\",\"type\":\"http\"},\"oauth2\":{\"flows\":{\"authorizationCode\":{\"authorizationUrl\":\"https://api.vercel.com/oauth/authorize\",\"scopes\":{},\"tokenUrl\":\"https://api.vercel.com/oauth/access_token\"}},\"type\":\"oauth2\"}},\"securitySource\":\"operation\"}"
