              lit: "log-drains"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
              "slug"
              "team_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
