# Entity: domain

main: kit: entity: domain: {

  alias: field: {}

  fields: [
    {
      name: "boughtAt"
      req: true
      short: "If it was purchased through Vercel, the timestamp in milliseconds when it was purchased."
      type: "`$NUMBER`"
    }
    {
      name: "createdAt"
      req: true
      short: "Timestamp in milliseconds when the domain was created in the registry."
      type: "`$NUMBER`"
    }
    {
      name: "creator"
      req: true
      short: "An object containing information of the domain creator, including the user's id, username, and email."
      type: "`$OBJECT`"
    }
    {
      name: "customNameservers"
      req: false
      short: "A list of custom nameservers for the domain to point to."
      type: "`$ARRAY`"
    }
    {
      name: "echMode"
      req: true
      short: "Whether the domain is enrolled in Encrypted Client Hello."
      type: "`$STRING`"
    }
    {
      name: "expiresAt"
      req: true
      short: "Timestamp in milliseconds at which the domain is set to expire."
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the domain."
      type: "`$STRING`"
    }
    {
      name: "intendedNameservers"
      req: true
      short: "A list of the intended nameservers for the domain to point to Vercel DNS."
      type: "`$ARRAY`"
    }
    {
      name: "method"
      req: false
      short: "The domain operation to perform."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The domain name."
      type: "`$STRING`"
    }
    {
      name: "nameservers"
      req: true
      short: "A list of the current nameservers of the domain."
      type: "`$ARRAY`"
    }
    {
      name: "renew"
      req: false
      short: "Indicates whether the domain is set to automatically renew."
      type: "`$BOOLEAN`"
    }
    {
      name: "serviceType"
      req: true
      short: "The type of service the domain is handled by."
      type: "`$STRING`"
    }
    {
      name: "suffix"
      req: true
      type: "`$BOOLEAN`"
    }
    {
      name: "teamId"
      req: true
      type: "`$STRING`"
    }
    {
      name: "transferStartedAt"
      req: false
      short: "If transferred into Vercel, timestamp in milliseconds when the domain transfer was initiated."
      type: "`$NUMBER`"
    }
    {
      name: "transferredAt"
      req: false
      short: "Timestamp in milliseconds at which the domain was successfully transferred into Vercel."
      type: "`$NUMBER`"
    }
    {
      name: "userId"
      req: true
      type: "`$STRING`"
    }
    {
      name: "verified"
      req: true
      short: "If the domain has the ownership verified."
      type: "`$BOOLEAN`"
    }
  ]

