# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      name: "activeAt"
      req: true
      short: "Timestamp (in milliseconds) of when the token was most recently used."
      type: "`$NUMBER`"
    }
    {
      name: "createdAt"
      req: true
      short: "Timestamp (in milliseconds) of when the token was created."
      type: "`$NUMBER`"
    }
    {
      name: "expiresAt"
      req: false
      short: "Timestamp (in milliseconds) of when the token expires."
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: true
      short: "The unique identifier of the token."
      type: "`$STRING`"
    }
    {
      name: "leakedAt"
      req: false
      short: "Timestamp (in milliseconds) of when the token was marked as leaked."
      type: "`$NUMBER`"
    }
    {
      name: "leakedUrl"
      req: false
      short: "URL where the token was discovered as leaked."
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "The human-readable name of the token."
      type: "`$STRING`"
    }
    {
      name: "origin"
      req: false
      short: "The origin of how the token was created."
      type: "`$STRING`"
    }
    {
      name: "prefix"
      req: false
      short: "The token's prefix, for identification purposes."
      type: "`$STRING`"
    }
    {
      name: "projectId"
      req: false
      short: "The ID of the project to scope this token to"
      type: "`$STRING`"
    }
    {
      name: "revokedAt"
      req: false
      short: "Timestamp (in milliseconds) of when the token was revoked."
      type: "`$NUMBER`"
    }
    {
      name: "scopes"
      req: false
      short: "The access scopes granted to the token."
      type: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    {
      name: "suffix"
      req: false
      short: "The last few characters of the token, for identification purposes."
      type: "`$STRING`"
    }
    {
      name: "type"
      req: true
      short: "The type of the token."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "authentication"
