oVariantId\":{\"description\":\"The variant to roll towards\",\"type\":\"string\"},\"slots\":{\"description\":\"Each slot defines a promille and how long it is served for. After all slots expire, 100% is served indefinitely. The final implicit 100% slot does not need to be listed. Example: [[5_000, 21_600_000], [10_000, 28_800_000]] means 5‰ for 6h, then 10‰ for 8h, then 100% indefinitely.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"durationMs\":{\"description\":\"How long this promille is served in ms before moving to the next slot.\",\"minimum\":0,\"type\":\"number\"},\"promille\":{\"description\":\"Promille of traffic for rollToVariant (0-100_000, where 1_000 = 1%)\",\"maximum\":100000,\"minimum\":0,\"type\":\"number\"}},\"required\":[\"promille\",\"durationMs\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"},\"startTimestamp\":{\"description\":\"Epoch ms when the rollout begins\",\"type\":\"number\"},\"type\":{}},\"required\":[\"type\",\"base\",\"startTimestamp\",\"rollFromVariantId\",\"rollToVariantId\",\"defaultVariantId\",\"slots\"],\"type\":\"object\"}]}},\"required\":[\"id\",\"conditions\",\"outcome\"],\"type\":\"object\"},\"maxItems\":10000,\"type\":\"array\"},\"targets\":{\"additionalProperties\":{\"additionalProperties\":{\"additionalProperties\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"note\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"value\"],\"type\":\"object\"},\"maxItems\":10000,\"type\":\"array\"},\"type\":\"object\"},\"type\":\"object\"},\"description\":\"Allows assigning targets to variants while bypassing the flag's rules\",\"type\":\"object\"}},\"required\":[\"active\",\"pausedOutcome\",\"rules\",\"fallthrough\"],\"type\":\"object\"},\"description\":\"The configuration for the flag in different environments\",\"maxProperties\":10,\"type\":\"object\"},\"maintainerIds\":{\"description\":\"The user ids of the maintainers of the flag\",\"items\":{\"maxLength\":24,\"type\":\"