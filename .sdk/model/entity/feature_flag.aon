e\":\"object\"},\"defaultVariantId\":{\"description\":\"This variant will be used when the base attribute does not exist\",\"type\":\"string\"},\"rollFromVariantId\":{\"description\":\"The variant to roll away from\",\"type\":\"string\"},\"rollToVariantId\":{\"description\":\"The variant to roll towards\",\"type\":\"string\"},\"slots\":{\"description\":\"Each slot defines a promille and how long it is served for. After all slots expire, 100% is served indefinitely. The final implicit 100% slot does not need to be listed. Example: [[5_000, 21_600_000], [10_000, 28_800_000]] means 5‰ for 6h, then 10‰ for 8h, then 100% indefinitely.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"durationMs\":{\"description\":\"How long this promille is served in ms before moving to the next slot.\",\"minimum\":0,\"type\":\"number\"},\"promille\":{\"description\":\"Promille of traffic for rollToVariant (0-100_000, where 1_000 = 1%)\",\"maximum\":100000,\"minimum\":0,\"type\":\"number\"}},\"required\":[\"promille\",\"durationMs\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"},\"startTimestamp\":{\"description\":\"Epoch ms when the rollout begins\",\"type\":\"number\"},\"type\":{}},\"required\":[\"type\",\"base\",\"startTimestamp\",\"rollFromVariantId\",\"rollToVariantId\",\"defaultVariantId\",\"slots\"],\"type\":\"object\"}]},\"pausedOutcome\":{\"additionalProperties\":false,\"properties\":{\"type\":{},\"variantId\":{\"type\":\"string\"}},\"required\":[\"type\",\"variantId\"],\"type\":\"object\"},\"reuse\":{\"additionalProperties\":false,\"description\":\"Allows linking this environment to another environment so this flag will be evaluated with the other flag's configuration\",\"properties\":{\"active\":{\"description\":\"Whether the reuse is active or not\",\"type\":\"boolean\"},\"environment\":{\"description\":\"The environment to link to\",\"type\":\"string\"}},\"required\":[\"active\",\"environment\"],\"type\":\"object\"},\"revision\":{\"description\":\"The r