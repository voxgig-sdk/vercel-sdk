          contract: {
            id: "PATCH /v1/projects/{projectIdOrName}/feature-flags/flags/{flagIdOrSlug}"
            json: "{\"operationId\":\"updateFlag\",\"parameters\":[{\"description\":\"The project id or name\",\"in\":\"path\",\"name\":\"projectIdOrName\",\"required\":true,\"schema\":{\"description\":\"The project id or name\",\"type\":\"string\"}},{\"description\":\"The flag id or name\",\"in\":\"path\",\"name\":\"flagIdOrSlug\",\"required\":true,\"schema\":{\"description\":\"The flag id or name\",\"type\":\"string\"}},{\"description\":\"Etag to match, can be used interchangeably with the `if-match` header\",\"in\":\"query\",\"name\":\"ifMatch\",\"required\":false,\"schema\":{\"description\":\"Etag to match, can be used interchangeably with the `if-match` header\",\"type\":\"string\"}},{\"description\":\"Whether to include metadata in the response\",\"in\":\"query\",\"name\":\"withMetadata\",\"required\":false,\"schema\":{\"description\":\"Whether to include metadata in the response\",\"type\":\"boolean\"}},{\"description\":\"The Team identifier to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"teamId\",\"schema\":{\"example\":\"team_1a2b3c4d5e6f7g8h9i0j1k2l\",\"type\":\"string\"}},{\"description\":\"The Team slug to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"slug\",\"schema\":{\"example\":\"my-team-url-slug\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"createdBy\":{\"description\":\"The user who created this patch\",\"type\":\"string\"},\"description\":{\"description\":\"A description of the flag\",\"type\":\"string\"},\"environments\":{\"additionalProperties\":{\"additionalProperties\":false,\"properties\":{\"active\":{\"type\":\"boolean\"},\"fallthrough\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{},\"variantId\":{\"type\":\"string\"}},\"required\":[\"type\",\"variantId\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"properties\":{\"attribute\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"type\":{}},\"required\":[\"type\",\"kind\",\"attribute\"],\"type\":\"object\"},\"defaultVariantId\":{\"description\":\"This variant will be used when the base attribute does not exist\",\"type\":\"string\"},\"type\":{},\"weights\":{\"additionalProperties\":{\"type\":\"number\"},\"description\":\"The distribution for each variant\",\"type\":\"object\"}},\"required\":[\"type\",\"base\",\"weights\",\"defaultVariantId\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"properties\":{\"attribute\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"type\":{}},\"required\":[\"type\",\"kind\",\"attribute\"],\"type\":\"object\"},\"defaultVariantId\":{\"description\":\"This variant will be used when the base attribute does not exist\",\"type\":\"string\"},\"rollFromVariantId\":{\"description\":\"The variant to roll away from\",\"type\":\"string\"},\"rollToVariantId\":{\"description\":\"The variant to roll towards\",\"type\":\"string\"},\"slots\":{\"description\":\"Each slot defines a promille and how long it is served for. After all slots expire, 100% is served indefinitely. The final implicit 100% slot does not need to be listed. Example: [[5_000, 21_600_000], [10_000, 28_800_000]] means 5‰ for 6h, then 10‰ for 8h, then 100% indefinitely.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"durationMs\":{\"description\":\"How long this promille is served in ms before moving to the next slot.\",\"minimum\":0,\"type\":\"number\"},\"promille\":{\"description\":\"Promille of traffic for rollToVariant (0-100_000, where 1_000 = 1%)\",\"maximum\":100000,\"minimum\":0,\"type\":\"number\"}},\"required\":[\"promille\",\"durationMs\"],\"type\":\"object\"},\"minItems\":1,\"type\":\"array\"},\"startTimestamp\":{\"description\":\"Epoch ms when the rollout begins\",\"type\":\"number\"},\"type\":{}},\"required\":[\"type\",\"base\",\"startTimestamp\",\"rollFromVariantId\",\"rollToVariantId\",\"defaultVariantId\",\"slots\"],\"type\":\"object\"}]},\"pausedOutcome\":{\"additionalProperties\":false,\"properties\":{\"type\":{},\"variantId\":{\"type\":\"string\"}},\"required\":[\"type\",\"variantId\"],\"type\":\"object\"},\"reuse\":{\"additionalProperties\":false,\"description\":\"Allows linking this environment to another environment so this flag will be evaluated with the other flag's configuration\",\"properties\":{\"active\":{\"description\":\"Whether the reuse is active or not\",\"type\":\"boolean\"},\"environment\":{\"description\":\"The environment to link to\",\"type\":\"string\"}},\"required\":[\"active\",\"environment\"],\"type\":\"object\"},\"revision\":{\"description\":\"The revision of the environment config\",\"type\":\"number\"},\"rules\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"conditions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"cmp\":{\"enum\":[\"eq\",\"!eq\",\"oneOf\",\"!oneOf\",\"containsAllOf\",\"containsAnyOf\",\"containsNoneOf\",\"startsWith\",\"!startsWith\",\"endsWith\",\"!endsWith\",\"contains\",\"!contains\",\"ex\",\"!ex\",\"gt\",\"gte\",\"lt\",\"lte\",\"regex\",\"!regex\",\"before\",\"after\"],\"type\":\"string\"},\"cmpOptions\":{\"additionalProperties\":false,\"properties\":{\"ignoreCase\":{\"type\":\"boolean\"}},\"type\":\"object\"},\"lhs\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"type\":{}},\"required\":[\"type\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"attribute\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"type\":{}},\"required\":[\"type\",\"kind\",\"attribute\"],\"type\":\"object\"}]},\"rhs\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"items\":{\"items\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"label\":{\"type\":\"string\"},\"note\":{\"type\":\"string\"},\"value\":{\"type\":\"number\"}},\"required\":[\"value\"],\"type\":\"object\