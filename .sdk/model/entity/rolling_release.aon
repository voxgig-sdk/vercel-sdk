# Entity: rolling_release

main: kit: entity: rolling_release: {

  alias: field: {}

  fields: [
    {
      name: "activeStage"
      req: true
      short: "The currently active stage, null if the rollout is aborted"
      type: "`$OBJECT`"
    }
    {
      name: "advancementType"
      req: true
      short: "The advancement type of the rolling release"
      type: "`$STRING`"
    }
    {
      name: "canaryDeployment"
      req: true
      short: "The canary deployment being rolled out"
      type: "`$OBJECT`"
    }
    {
      name: "currentCanaryPercentage"
      req: false
      short: "When set (for example while {@link substate} is `PAUSED`), the canary traffic percentage persisted on the rollout document — use for dashboard display when linear shift is active."
      type: "`$NUMBER`"
    }
    {
      name: "currentDeployment"
      req: true
      short: "The current deployment receiving production traffic"
      type: "`$OBJECT`"
    }
    {
      name: "nextStage"
      req: true
      short: "The next stage to be activated, null if not in ACTIVE state"
      type: "`$OBJECT`"
    }
    {
      name: "queuedDeploymentId"
      req: true
      short: "The ID of a deployment queued for the next rolling release"
      type: "`$STRING`"
    }
    {
      name: "stages"
      req: true
      short: "All stages configured for this rolling release"
      type: "`$ARRAY`"
    }
    {
      name: "startedAt"
      req: true
      short: "Unix timestamp in milliseconds when the rolling release started"
      type: "`$NUMBER`"
    }
    {
      name: "state"
      req: true
      short: "The current state of the rolling release"
      type: "`$STRING`"
    }
    {
      name: "substate"
      req: true
      short: "When set to `PAUSED`, the rollout is frozen at the current percentage until continued."
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: true
      short: "Unix timestamp in milliseconds when the rolling release was last updated"
      type: "`$NUMBER`"
    }
  ]

  name: "rolling_release"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "project_id"
                orig: "id_or_name"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "my-team-url-slug"
                kind: "query"
                name: "slug"
                orig: "slug"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "team_1a2b3c4d5e6f7g8h9i0j1k2l"
                kind: "query"
                name: "team_id"
                orig: "team_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "POST /v1/projects/{idOrName}/rolling-release/approve-stage"
            json: "{\"operationId\":\"approveRollingReleaseStage\",\"parameters\":[{\"description\":\"Project ID or project name (URL-encoded)\",\"in\":\"path\",\"name\":\"idOrName\",\"required\":true,\"schema\":{\"description\":\"Project ID or project name (URL-encoded)\",\"type\":\"string\"}},{\"description\":\"The Team identifier to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"teamId\",\"schema\":{\"example\":\"team_1a2b3c4d5e6f7g8h9i0j1k2l\",\"type\":\"string\"}},{\"description\":\"The Team slug to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"slug\",\"schema\":{\"example\":\"my-team-url-slug\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"canaryDeploymentId\":{\"description\":\"The id of the canary deployment to approve for the next stage\",\"type\":\"string\"},\"nextStageIndex\":{\"description\":\"The index of the stage to transition to\",\"type\":\"number\"}},\"required\":[\"nextStageIndex\",\"canaryDeploymentId\"],\"type\":\"object\"}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"description\":\"The response format for rolling release endpoints that return rolling release information\",\"properties\":{\"rollingRelease\":{\"description\":\"Rolling release information including configuration and document details, or null if no rolling release exists\",\"nullable\":true,\"properties\":{\"activeStage\":{\"description\":\"The currently active stage, null if the rollout is aborted\",\"example\":{\"duration\":null,\"index\":1,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":25},\"nullable\":true,\"properties\":{\"duration\":{\"description\":\"Duration in seconds for automatic advancement, null for manual stages or the final stage\",\"example\":null,\"nullable\":true,\"type\":\"number\"},\"index\":{\"description\":\"The zero-based index of the stage\",\"example\":0,\"type\":\"number\"},\"isFinalStage\":{\"description\":\"Whether or not this stage is the final stage (targetPercentage === 100)\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"linearShift\":{\"description\":\"Whether to linearly shift traffic over the duration of this stage\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"requireApproval\":{\"description\":\"Whether or not this stage requires manual approval to proceed\",\"enum\":[false,true],\"type\":\"boolean\"},\"targetPercentage\":{\"description\":\"The percentage of traffic to serve to the canary deployment (0-100)\",\"example\":25,\"type\":\"number\"}},\"required\":[\"duration\",\"index\",\"isFinalStage\",\"requireApproval\",\"targetPercentage\"],\"type\":\"object\"},\"advancementType\":{\"description\":\"The advancement type of the rolling release\",\"enum\":[\"automatic\",\"manual-approval\"],\"example\":\"manual-approval\",\"type\":\"string\"},\"canaryDeployment\":{\"description\":\"The canary deployment being rolled out\",\"example\":{\"createdAt\":1716210100000,\"id\":\"dpl_def456\",\"name\":\"my-shop@9c7e2f4\",\"readyState\":\"READY\",\"readyStateAt\":1716210400000,\"source\":\"git\",\"target\":\"production\",\"url\":\"9c7e2f4-my-shop.vercel.app\"},\"nullable\":true,\"properties\":{\"createdAt\":{\"description\":\"A number containing the date when the deployment was created in milliseconds\",\"example\":1540257589405,\"type\":\"number\"},\"id\":{\"description\":\"A string holding the unique ID of the deployment\",\"example\":\"dpl_89qyp1cskzkLrVicDaZoDbjyHuDJ\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the project associated with the deployment at the time that the deployment was created\",\"example\":\"my-project\",\"type\":\"string\"},\"readyState\":{\"description\":\"The state of the deployment depending on the process of deploying, or if it is ready or in an error state\",\"enum\":[\"BLOCKED\",\"BUILDING\",\"CANCELED\",\"ERROR\",\"INITIALIZING\",\"QUEUED\",\"READY\"],\"example\":\"READY\",\"type\":\"string\"},\"readyStateAt\":{\"type\":\"number\"},\"source\":{\"description\":\"Where was the deployment created from. Best-effort guess for metrics only — not authoritative; do not gate behavior on it.\",\"enum\":[\"api-trigger-git-deploy\",\"cli\",\"clone/repo\",\"drop\",\"git\",\"git-deploy-hook\",\"import\",\"import/repo\",\"redeploy\",\"v0-web\"],\"example\":\"cli\",\"type\":\"string\"},\"target\":{\"description\":\"If defined, either `staging` if a staging alias in the format `<project>.<team>.now.sh` was assigned upon creation, or `production` if the aliases from `alias` were assigned. `null` value indicates the \\\"preview\\\" deployment.\",\"enum\":[\"production\",\"staging\",null],\"example\":null,\"nullable\":true,\"type\":\"string\"},\"url\":{\"description\":\"A string with the unique URL of the deployment\",\"example\":\"my-instant-deployment-3ij3cxz9qr.now.sh\",\"type\":\"string\"}},\"required\":[\"createdAt\",\"id\",\"name\",\"readyState\",\"url\"],\"type\":\"object\"},\"currentCanaryPercentage\":{\"description\":\"When set (for example while {@link substate} is `PAUSED`), the canary traffic percentage persisted on the rollout document — use for dashboard display when linear shift is active.\",\"type\":\"number\"},\"currentDeployment\":{\"description\":\"The current deployment receiving production traffic\",\"example\":{\"createdAt\":1716206500000,\"id\":\"dpl_abc123\",\"name\":\"my-shop@main\",\"readyState\":\"READY\",\"readyStateAt\":1716206800000,\"source\":\"git\",\"target\":\"production\",\"url\":\"my-shop.vercel.app\"},\"nullable\":true,\"properties\":{\"createdAt\":{\"description\":\"A number containing the date when the deployment was created in milliseconds\",\"example\":1540257589405,\"type\":\"number\"},\"id\":{\"description\":\"A string holding the unique ID of the deployment\",\"example\":\"dpl_89qyp1cskzkLrVicDaZoDbjyHuDJ\",\"type\":\"string\"},\"name\":{\"description\":\"The name of the project associated with the deployment at the time that the deployment was created\",\"example\":\"my-project\",\"type\":\"string\"},\"readyState\":{\"description\":\"The state of the deployment depending on the process of deploying, or if it is ready or in an error state\",\"enum\":[\"BLOCKED\",\"BUILDING\",\"CANCELED\",\"ERROR\",\"INITIALIZING\",\"QUEUED\",\"READY\"],\"example\":\"READY\",\"type\":\"string\"},\"readyStateAt\":{\"type\":\"number\"},\"source\":{\"description\":\"Where was the deployment created from. Best-effort guess for metrics only — not authoritative; do not gate behavior on it.\",\"enum\":[\"api-trigger-git-deploy\",\"cli\",\"clone/repo\",\"drop\",\"git\",\"git-deploy-hook\",\"import\",\"import/repo\",\"redeploy\",\"v0-web\"],\"example\":\"cli\",\"type\":\"string\"},\"target\":{\"description\":\"If defined, either `staging` if a staging alias in the format `<project>.<team>.now.sh` was assigned upon creation, or `production` if the aliases from `alias` were assigned. `null` value indicates the \\\"preview\\\" deployment.\",\"enum\":[\"production\",\"staging\",null],\"example\":null,\"nullable\":true,\"type\":\"string\"},\"url\":{\"description\":\"A string with the unique URL of the deployment\",\"example\":\"my-instant-deployment-3ij3cxz9qr.now.sh\",\"type\":\"string\"}},\"required\":[\"createdAt\",\"id\",\"name\",\"readyState\",\"url\"],\"type\":\"object\"},\"nextStage\":{\"description\":\"The next stage to be activated, null if not in ACTIVE state\",\"example\":{\"duration\":null,\"index\":2,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":60},\"nullable\":true,\"properties\":{\"duration\":{\"description\":\"Duration in seconds for automatic advancement, null for manual stages or the final stage\",\"example\":null,\"nullable\":true,\"type\":\"number\"},\"index\":{\"description\":\"The zero-based index of the stage\",\"example\":0,\"type\":\"number\"},\"isFinalStage\":{\"description\":\"Whether or not this stage is the final stage (targetPercentage === 100)\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"linearShift\":{\"description\":\"Whether to linearly shift traffic over the duration of this stage\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"requireApproval\":{\"description\":\"Whether or not this stage requires manual approval to proceed\",\"enum\":[false,true],\"type\":\"boolean\"},\"targetPercentage\":{\"description\":\"The percentage of traffic to serve to the canary deployment (0-100)\",\"example\":25,\"type\":\"number\"}},\"required\":[\"duration\",\"index\",\"isFinalStage\",\"requireApproval\",\"targetPercentage\"],\"type\":\"object\"},\"queuedDeploymentId\":{\"description\":\"The ID of a deployment queued for the next rolling release\",\"example\":\"dpl_ghi789\",\"nullable\":true,\"type\":\"string\"},\"stages\":{\"description\":\"All stages configured for this rolling release\",\"example\":[{\"duration\":null,\"index\":0,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":5},{\"duration\":null,\"index\":1,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":25},{\"duration\":null,\"index\":2,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":60},{\"duration\":null,\"index\":3,\"isFinalStage\":true,\"requireApproval\":false,\"targetPercentage\":100}],\"items\":{\"description\":\"All stages configured for this rolling release\",\"example\":[{\"duration\":null,\"index\":0,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":5},{\"duration\":null,\"index\":1,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":25},{\"duration\":null,\"index\":2,\"isFinalStage\":false,\"requireApproval\":true,\"targetPercentage\":60},{\"duration\":null,\"index\":3,\"isFinalStage\":true,\"requireApproval\":false,\"targetPercentage\":100}],\"properties\":{\"duration\":{\"description\":\"Duration in seconds for automatic advancement, null for manual stages or the final stage\",\"example\":null,\"nullable\":true,\"type\":\"number\"},\"index\":{\"description\":\"The zero-based index of the stage\",\"example\":0,\"type\":\"number\"},\"isFinalStage\":{\"description\":\"Whether or not this stage is the final stage (targetPercentage === 100)\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"linearShift\":{\"description\":\"Whether to linearly shift traffic over the duration of this stage\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"requireApproval\":{\"description\":\"Whether or not this stage requires manual approval to proceed\",\"enum\":[false,true],\"type\":\"boolean\"},\"targetPercentage\":{\"description\":\"The percentage of traffic to serve to the canary deployment (0-100)\",\"example\":25,\"type\":\"number\"}},\"required\":[\"duration\",\"index\",\"isFinalStage\",\"requireApproval\",\"targetPercentage\"],\"type\":\"object\"},\"type\":\"array\"},\"startedAt\":{\"description\":\"Unix timestamp in milliseconds when the rolling release started\",\"example\":1716210500000,\"type\":\"number\"},\"state\":{\"description\":\"The current state of the rolling release\",\"enum\":[\"ABORTED\",\"ACTIVE\",\"COMPLETE\"],\"example\":\"ACTIVE\",\"type\":\"string\"},\"substate\":{\"description\":\"When set to `PAUSED`, the rollout is frozen at the current percentage until continued.\",\"enum\":[\"PAUSED\",null],\"nullable\":true,\"type\":\"string\"},\"updatedAt\":{\"description\":\"Unix timestamp in milliseconds when the rolling release was last updated\",\"example\":1716210600000,\"type\":\"number\"}},\"required\":[\"activeStage\",\"advancementType\",\"canaryDeployment\",\"currentDeployment\",\"nextStage\",\"queuedDeploymentId\",\"stages\",\"startedAt\",\"state\",\"substate\",\"updatedAt\"],\"type\":\"object\"}},\"required\":[\"rollingRelease\"],\"type\":\"object\"}}},\"description\":\"\"},\"400\":{\"description\":\"One of the provided values in the request body is invalid.\\nOne of the provided values in the request query is invalid.\"},\"401\":{\"