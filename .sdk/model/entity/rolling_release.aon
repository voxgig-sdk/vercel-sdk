          contract: {
            id: "GET /v1/projects/{idOrName}/rolling-release/config"
            json: "{\"operationId\":\"getRollingReleaseConfig\",\"parameters\":[{\"description\":\"Project ID or project name (URL-encoded)\",\"in\":\"path\",\"name\":\"idOrName\",\"required\":true,\"schema\":{\"description\":\"Project ID or project name (URL-encoded)\",\"type\":\"string\"}},{\"description\":\"The Team identifier to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"teamId\",\"schema\":{\"example\":\"team_1a2b3c4d5e6f7g8h9i0j1k2l\",\"type\":\"string\"}},{\"description\":\"The Team slug to perform the request on behalf of.\",\"in\":\"query\",\"name\":\"slug\",\"schema\":{\"example\":\"my-team-url-slug\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"rollingRelease\":{\"description\":\"Project-level rolling release configuration that defines how deployments should be gradually rolled out\",\"nullable\":true,\"properties\":{\"canaryResponseHeader\":{\"description\":\"Whether the request served by a canary deployment should return a header indicating a canary was served. Defaults to `false` when omitted.\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"gate\":{\"description\":\"Automated gating configuration. Omitted (the default) means no gating is configured, which is equivalent to `enabled: false`.\",\"properties\":{\"action\":{\"description\":\"What to do when the gate trips: pause the rollout, or roll it back.\",\"enum\":[\"pause\",\"rollback\"],\"type\":\"string\"},\"checks\":{\"description\":\"The checks to evaluate. An empty array means nothing is evaluated.\",\"items\":{\"description\":\"The checks to evaluate. An empty array means nothing is evaluated.\",\"properties\":{\"excludePaths\":{\"description\":\"Request paths to ignore entirely — dropped from both the numerator (errors) and the denominator (total requests). Matched exactly against the request path with any query string removed; no prefix or glob matching. Defaults to `[]` when omitted.\",\"example\":[\"/api/health\"],\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"excludeStatusCodes\":{\"description\":\"Response status codes to ignore entirely — dropped from both the numerator (errors) and the denominator (total requests). Defaults to `[]` when omitted.\",\"example\":[503],\"items\":{\"type\":\"number\"},\"type\":\"array\"},\"ingestWatermarkSeconds\":{\"description\":\"Seconds of ingest lag to allow for: the query's upper bound is `now() - this value`, so the check never reads a window that is still filling. Defaults to `30` when omitted.\",\"example\":30,\"type\":\"number\"},\"minSampleSize\":{\"description\":\"Minimum number of requests required in the window before the check can fail. Below this, the check is inconclusive rather than failing, so low-traffic stages don't gate on noise. Defaults to `100` when omitted.\",\"example\":100,\"type\":\"number\"},\"type\":{\"description\":\"The metric this check evaluates.\",\"enum\":[\"error-rate-5xx\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"type\":\"array\"},\"dryRun\":{\"description\":\"When true, a tripped gate is only reported — {@link action} is not taken.\",\"enum\":[false,true],\"type\":\"boolean\"},\"enabled\":{\"description\":\"Whether automated gating is enabled for this project's rollouts.\",\"enum\":[false,true],\"type\":\"boolean\"},\"failureThreshold\":{\"description\":\"How many failing evaluations within {@link windowSize} trip the gate. Defaults to `3` when omitted.\",\"example\":3,\"type\":\"number\"},\"windowSize\":{\"description\":\"How many of the most recent evaluations {@link failureThreshold} is counted against. Defaults to `5` when omitted.\",\"example\":5,\"type\":\"number\"}},\"required\":[\"action\",\"checks\",\"dryRun\",\"enabled\"],\"type\":\"object\"},\"stages\":{\"description\":\"An array of all the stages required during a deployment release. Each stage defines a target percentage and advancement rules. The final stage must always have targetPercentage: 100.\",\"items\":{\"description\":\"An array of all the stages required during a deployment release. Each stage defines a target percentage and advancement rules. The final stage must always have targetPercentage: 100.\",\"properties\":{\"duration\":{\"description\":\"Duration in minutes for automatic advancement to the next stage\",\"example\":600,\"type\":\"number\"},\"linearShift\":{\"description\":\"Whether to linearly shift traffic over the duration of this stage\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"requireApproval\":{\"description\":\"Whether or not this stage requires manual approval to proceed\",\"enum\":[false,true],\"example\":false,\"type\":\"boolean\"},\"targetPercentage\":{\"description\":\"The percentage of traffic to serve to the canary deployment (0-100)\",\"example\":25,\"type\":\"number\"}},\"required\":[\"targetPercentage\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"target\":{\"description\":\"The environment that the release targets, currently only supports production. Adding in case we want to configure with alias groups or custom environments.\",\"example\":\"production\",\"type\":\"string\"}},\"required\":[\"target\"],\"type\":\"object\"}},\"required\":[\"rollingRelease\"],\"type\":\"object\"}}},\"description\":\"\"},\"400\":{\"description\":\"One of the provided values in the request query is invalid.\"},\"401\":{\"description\":\"The request is not authorized.\"},\"403\":{\"description\":\"You do not have permission to access this resource.\"},\"404\":{\"description\":\"\"},\"410\":{\"description\":\"\"}},\"security\":[{\"bearerToken\":[]}],\"securitySchemes\":{\"bearerToken\":{\"description\":\"Default authentication mechanism\",\"scheme\":\"bearer\",\"type\":\"http\"},\"oauth2\":{\"flows\":{\"authorizationCode\":{\"authorizationUrl\":\"https://api.vercel.com/oauth/authorize\",\"scopes\":{},\"tokenUrl\":\"https://api.vercel.com/oauth/access_token\"}},\"type\":\"oauth2\"}},\"securitySource\":\"operation\"}"
